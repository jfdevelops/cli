{
  "name": "@jfdevelops/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Project scaffolding and package-owned skill discovery for jfdevelops",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfdevelops/cli.git"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm test && pnpm check:skills",
    "check:skills": "node scripts/check-skills.mjs",
    "typecheck": "tsc",
    "test": "vitest run",
    "skills:sync": "node ../skills/scripts/sync-agent-skills.mjs .",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
